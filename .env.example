# При пустом APP_SECRET сервис сам создаёт ключ в постоянном томе /data.
# Для нового стенда используйте новый том; не копируйте data/ из истории Git.
APP_SECRET=
# Пустое значение отключает сервисный Bearer-доступ. Для API задайте случайный токен.
API_TOKEN=
# За HTTPS-прокси обязательно true; для http://localhost:8080 оставьте false.
COOKIE_SECURE=false
ALLOW_LOCAL_REPOS=false
ZEROCRACY_AUTO_ASSIGN=false
SYNC_INTERVAL=6h
REPORT_INTERVAL=168h
